<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>

	<parent>
		<groupId>com.holon-platform.jpa</groupId>
		<artifactId>holon-datastore-jpa-root</artifactId>
		<version>12.0.0</version>
	</parent>

	<artifactId>documentation-datastore-jpa</artifactId>
	<packaging>jar</packaging>

	<name>${project.groupId}:${project.artifactId}</name>
	<description>Holon JPA Datastore documentation</description>

	<url>https://holon-platform.com</url>

	<properties>
		<skipTests>true</skipTests>
		<jacoco.skip>true</jacoco.skip>
	</properties>

	<build>
		<resources>
			<resource>
				<directory>${project.basedir}/src/docs/asciidoc</directory>
			</resource>
		</resources>

		<plugins>
			<!-- Asciidoc reference documentation to HTML and PDF -->
			<plugin>
				<groupId>org.asciidoctor</groupId>
				<artifactId>asciidoctor-maven-plugin</artifactId>
				<configuration combine.self="override">
					<sourceDirectory>src/docs/asciidoc/reference</sourceDirectory>
					<attributes>
						<source-highlighter>coderay</source-highlighter>
						<endpoint-url>https://holon-platform.com</endpoint-url>
						<sourcedir>${project.basedir}/src/main/java</sourcedir>
						<project-version>${project.version}</project-version>
						<examplesdir>${project.basedir}/src/main/java</examplesdir>
						<icons>font</icons>
						<idprefix></idprefix>
						<idseparator>-</idseparator>
						<docinfo1>true</docinfo1>
						<docinfodir>${project.build.directory}/maven-shared-archive-resources/documentation</docinfodir>
						<last-update-label>false</last-update-label>
						<theme>flask</theme>
						<tabsize>2</tabsize>
					</attributes>
				</configuration>
				<executions>
					<execution>
						<id>asciidoc-to-html</id>
						<phase>package</phase>
						<goals>
							<goal>process-asciidoc</goal>
						</goals>
						<configuration combine.self="override">
							<backend>html5</backend>
							<sourceDirectory>src/docs/asciidoc/reference</sourceDirectory>
							<attributes>
								<source-highlighter>coderay</source-highlighter>
								<sectanchors>true</sectanchors>
								<linkcss>true</linkcss>
								<endpoint-url>https://holon-platform.com</endpoint-url>
								<sourcedir>${project.basedir}/src/main/java</sourcedir>
								<project-version>${project.version}</project-version>
								<examplesdir>${project.basedir}/src/main/java</examplesdir>
								<icons>font</icons>
								<idprefix></idprefix>
								<idseparator>-</idseparator>
								<docinfo1>true</docinfo1>
								<docinfodir>${project.build.directory}/maven-shared-archive-resources/documentation</docinfodir>
								<last-update-label>false</last-update-label>
								<theme>flask</theme>
								<tabsize>2</tabsize>
							</attributes>
						</configuration>
					</execution>
					<execution>
						<id>asciidoc-to-pdf</id>
						<phase>package</phase>
						<goals>
							<goal>process-asciidoc</goal>
						</goals>
						<configuration combine.self="override">
							<backend>pdf</backend>
							<sourceDirectory>src/docs/asciidoc/reference</sourceDirectory>
							<attributes>
								<source-highlighter>coderay</source-highlighter>
								<pagenums></pagenums>
								<toc></toc>
								<pdf-stylesdir>${project.build.directory}/maven-shared-archive-resources/documentation/theme</pdf-stylesdir>
								<pdf-style>holon</pdf-style>
								<endpoint-url>https://holon-platform.com</endpoint-url>
								<sourcedir>${project.basedir}/src/main/java</sourcedir>
								<project-version>${project.version}</project-version>
								<examplesdir>${project.basedir}/src/main/java</examplesdir>
								<icons>font</icons>
								<idprefix></idprefix>
								<idseparator>-</idseparator>
								<docinfo1>true</docinfo1>
								<docinfodir>${project.build.directory}/maven-shared-archive-resources/documentation</docinfodir>
								<last-update-label>false</last-update-label>
								<theme>flask</theme>
								<tabsize>2</tabsize>
							</attributes>
						</configuration>
					</execution>
				</executions>
			</plugin>
			<!-- Assembly docs -->
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-assembly-plugin</artifactId>
				<configuration>
					<appendAssemblyId>true</appendAssemblyId>
					<finalName>${project.artifactId}-${project.version}</finalName>
					<descriptorRefs>
						<descriptorRef>reference-docs</descriptorRef>
					</descriptorRefs>
				</configuration>
				<executions>
					<execution>
						<id>assembly-docs</id>
						<phase>package</phase>
						<goals>
							<goal>single</goal>
						</goals>
					</execution>
				</executions>
			</plugin>
		</plugins>
	</build>

	<dependencies>
		<dependency>
			<groupId>com.holon-platform.jpa</groupId>
			<artifactId>holon-datastore-jpa</artifactId>
		</dependency>
		<dependency>
			<groupId>com.holon-platform.jpa</groupId>
			<artifactId>holon-datastore-jpa-spring</artifactId>
		</dependency>
		<dependency>
			<groupId>com.holon-platform.jpa</groupId>
			<artifactId>holon-datastore-jpa-spring-boot</artifactId>
		</dependency>

		<!-- JPA API -->
		<dependency>
			<groupId>jakarta.persistence</groupId>
			<artifactId>jakarta.persistence-api</artifactId>
			<scope>provided</scope>
		</dependency>
	</dependencies>

</project>