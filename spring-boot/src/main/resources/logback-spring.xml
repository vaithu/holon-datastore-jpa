<?xml version="1.0" encoding="UTF-8"?>
<configuration>
	<!-- Spring Boot default configuration support -->
	<include resource="org/springframework/boot/logging/logback/defaults.xml" />

	<!-- Properties -->
	<property name="LOG_FILE" value="${LOG_FILE:-${LOG_PATH:-${LOG_TEMP:-${java.io.tmpdir:-/tmp}}/}spring.log}" />
	<property name="LOG_PATTERN_CONSOLE" value="%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msg%n" />
	<property name="LOG_PATTERN_FILE" value="%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msg%n" />

	<!-- Define the JSON encoder for structured logging -->
	<appender name="CONSOLE_JSON" class="ch.qos.logback.core.ConsoleAppender">
		<encoder class="net.logstash.logback.encoder.LoggingEventCompositeJsonEncoder">
			<providers>
				<!-- Standard fields -->
				<timestamp>
					<timeZone>UTC</timeZone>
					<fieldName>@timestamp</fieldName>
				</timestamp>
				<version>
					<fieldName>@version</fieldName>
				</version>

				<!-- Application fields -->
				<logLevel>
					<fieldName>level</fieldName>
				</logLevel>
				<loggerName>
					<fieldName>logger_name</fieldName>
				</loggerName>
				<threadName>
					<fieldName>thread_name</fieldName>
				</threadName>
				<message>
					<fieldName>message</fieldName>
				</message>

				<!-- Holon Datastore specific fields -->
				<mdc>
					<fieldName>context</fieldName>
				</mdc>

				<!-- Trace context for distributed tracing (W3C format) -->
				<logstashMarkers />

				<!-- Exception information -->
				<stacktrace>
					<fieldName>stack_trace</fieldName>
					<throwableConverter class="net.logstash.logback.stacktrace.ShortenedThrowableConverter">
						<maxDepthPerThrowable>30</maxDepthPerThrowable>
						<maxLength>2048</maxLength>
						<shortenedClassNameLength>20</shortenedClassNameLength>
						<rootCauseFirst>true</rootCauseFirst>
					</throwableConverter>
				</stacktrace>
			</providers>
		</encoder>
	</appender>

	<!-- File appender with JSON encoding -->
	<appender name="FILE_JSON" class="ch.qos.logback.core.rolling.RollingFileAppender">
		<file>${LOG_FILE}</file>
		<rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
			<fileNamePattern>${LOG_FILE}.%d{yyyy-MM-dd}.%i.gz</fileNamePattern>
			<maxFileSize>10MB</maxFileSize>
			<maxHistory>30</maxHistory>
			<totalSizeCap>1GB</totalSizeCap>
		</rollingPolicy>
		<encoder class="net.logstash.logback.encoder.LoggingEventCompositeJsonEncoder">
			<providers>
				<timestamp>
					<timeZone>UTC</timeZone>
					<fieldName>@timestamp</fieldName>
				</timestamp>
				<version>
					<fieldName>@version</fieldName>
				</version>
				<logLevel>
					<fieldName>level</fieldName>
				</logLevel>
				<loggerName>
					<fieldName>logger_name</fieldName>
				</loggerName>
				<threadName>
					<fieldName>thread_name</fieldName>
				</threadName>
				<message>
					<fieldName>message</fieldName>
				</message>
				<mdc>
					<fieldName>context</fieldName>
				</mdc>
				<logstashMarkers />
				<stacktrace>
					<fieldName>stack_trace</fieldName>
					<throwableConverter class="net.logstash.logback.stacktrace.ShortenedThrowableConverter">
						<maxDepthPerThrowable>30</maxDepthPerThrowable>
						<maxLength>2048</maxLength>
						<shortenedClassNameLength>20</shortenedClassNameLength>
						<rootCauseFirst>true</rootCauseFirst>
					</throwableConverter>
				</stacktrace>
			</providers>
		</encoder>
	</appender>

	<!-- Plain text console appender (for development) -->
	<appender name="CONSOLE_TEXT" class="ch.qos.logback.core.ConsoleAppender">
		<encoder>
			<pattern>${LOG_PATTERN_CONSOLE}</pattern>
			<charset>UTF-8</charset>
		</encoder>
	</appender>

	<!-- Spring profiles: production uses JSON, development uses text -->

	<!-- Production profile: JSON logging -->
	<springProfile name="prod">
		<root level="INFO">
			<appender-ref ref="CONSOLE_JSON" />
			<appender-ref ref="FILE_JSON" />
		</root>
		<logger name="com.holonplatform.datastore.jpa" level="INFO" />
	</springProfile>

	<!-- Default/Development profile: text logging -->
	<springProfile name="!prod">
		<root level="DEBUG">
			<appender-ref ref="CONSOLE_TEXT" />
		</root>
		<logger name="com.holonplatform.datastore.jpa" level="DEBUG" />
		<logger name="org.springframework" level="INFO" />
		<logger name="org.hibernate" level="INFO" />
	</springProfile>

	<!-- Fallback: Use JSON console if no profile specified -->
	<root level="INFO">
		<appender-ref ref="CONSOLE_JSON" />
	</root>

	<!-- Holon Datastore logger -->
	<logger name="com.holonplatform.datastore.jpa" level="INFO" additivity="false">
		<appender-ref ref="CONSOLE_JSON" />
		<appender-ref ref="FILE_JSON" />
	</logger>

	<!-- ORM loggers -->
	<logger name="org.hibernate.SQL" level="DEBUG" />
	<logger name="org.hibernate.type.descriptor.sql" level="TRACE" />
	<logger name="org.eclipse.persistence" level="INFO" />

	<!-- Spring Framework -->
	<logger name="org.springframework.boot" level="INFO" />
	<logger name="org.springframework.data" level="INFO" />

</configuration>
